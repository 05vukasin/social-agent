# Template only. The real file is /etc/social-agent/.env (mode 600), generated by modules/01-env.sh.
# Every key below is created automatically with a random value if missing. Edit there, never here.
AGENT_USER=agent
AGENT_PASSWORD=
VNC_PASSWORD=            # max 8 chars (VNC protocol limit)
VNC_GEOMETRY=1920x1080
SA_TZ=Europe/Belgrade
SA_DATA=/srv/social-agent
POSTGRES_DB=social_agent
POSTGRES_USER=sa_admin
POSTGRES_PASSWORD=
PG_AGENT_USER=sa_agent
PG_AGENT_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_CAPACITY=60G
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=social-agent
S3_ACCESS_KEY_ID=        # GK + 24 hex
S3_SECRET_ACCESS_KEY=    # 64 hex
BACKUP_RETENTION_DAYS=30
GITHUB_KEYS_USER=        # optional: also authorize https://github.com/<user>.keys for the agent user
